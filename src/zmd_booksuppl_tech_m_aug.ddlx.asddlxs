@Metadata.layer: #CORE
@Search.searchable: true
@UI.headerInfo: {
    typeName: 'BookingSuppl',
    typeNamePlural: 'BookingSupplemets',
    title: {
        type: #STANDARD,
        label: 'Booking Supplements',
        value: 'BookingSupplementId'
    }
}

annotate view ZP_BOKKSUPPL_TECH_M_AUG with
{

  @UI.facet: [{          // This is to give another object phase for booking supplements
      id: 'BookingSuppl',
      purpose: #STANDARD,
      position: 10,
      label: 'Booking Supplements',
      type: #IDENTIFICATION_REFERENCE
  }]

  @UI:{ lineItem: [{ position: 10 }],
          identification: [{ position: 10 }]
           }
  @Search.defaultSearchElement: true
  TravelId;
  @UI:{ lineItem: [{ position: 20 }],
      identification: [{ position: 20 }]
       }
  @Search.defaultSearchElement: true
  BookingId;
  @UI:{ lineItem: [{ position: 30 }],
      identification: [{ position: 30 }]
       }
  BookingSupplementId;
  @UI:{ lineItem: [{ position: 40 }],
      identification: [{ position: 40 }]
       }
  @Consumption.valueHelpDefinition: [{
      entity: {
          name: '/DMO/I_Supplement',
          element: 'SupplementID'
      },
      additionalBinding: [{element: 'SupplementID', localElement: 'SupplementId'},
                        {element: 'Price', localElement: 'Price'},
                         {element: 'CurrencyCode', localElement: 'CurrencyCode'} ]
  }]
  SupplementId;
  @UI:{ lineItem: [{ position: 50 }],
      identification: [{ position: 50 }]
       }
  Price;
  @UI:{ lineItem: [{ position: 60 }],
      identification: [{ position: 60 }]
       }
  @Consumption.valueHelpDefinition: [{
      entity: {
          name: 'I_Currency',
          element: 'Currency'
      }
  }]
  CurrencyCode;
  @UI:{ lineItem: [{ position: 70 }],
      identification: [{ position: 70 }]
       }
  @UI.hidden: true
  LastChangedAt;


}