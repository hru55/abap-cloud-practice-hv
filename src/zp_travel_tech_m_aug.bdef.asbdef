projection;
strict ( 2 );

define behavior for ZP_TRAVEL_TECH_M_AUG //alias <alias_name>
use etag  // after mentioning in interface bdl then write use etag here
{
  use create;
  use update;
  use delete;
  use action copyTravel;

  use association _Booking { create; }
}

define behavior for ZP_BOOKING_TECH_M_AUG //alias <alias_name>
use etag
{
  use update;
  use delete;

  use association _Travel;
  use association _BookingSupp { create; }
}

define behavior for ZP_BOKKSUPPL_TECH_M_AUG //alias <alias_name>
use etag
{
  use update;
  use delete;

  use association _Travel;
  use association _Booking;
}