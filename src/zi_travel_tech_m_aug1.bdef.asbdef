// Non standard operations - actions and functions
// actions -  these are mainly used to change the state of the object with out going to modifiable mode. these are degined in behaviour pool
// processor meas creating new entry,deleting or modifying the data. copy travel action is mainly an processor.
//copy travel action - it is mainly used to create a new record which is copy of an existing record.
//approver -  approve or reject the travel instance
//Actionrecalctotalprice - used to calculate the total price of one travel BO instance.
// then define action,factory action and internal action in zi_travel_tech_m_aug1.
// then press crtl + 1 and implement all these actions
// Then implement copy travel action where already implementation has been declared.
// Once copy travel is implemented then go to behvaour definition of projection view and tehn decalre action copy_trvel there.
// then go to meta data extension of travel tech and decalre ui annotation to visible those actions on the screen

strict ( 2 );

define behavior for ZI_TRAVEL_TECH_M_AUG1 //alias <alias_name>
implementation in class zbp_i_travel_tech_m_aug1 unique // this line added newly after creating BDL
persistent table ztravel_tech_m
lock master
authorization master ( instance )
etag master LastChangedAt // after mentioning annotation for last changed at field
// in zi_travel_tech_m after that mention last changed at here
// etag depenedent by parent assocaition this can be used to inherit the parent etag to child.
// byt thie etag dependent by can not be used for parent view only for child, for parent etag master only to be used.
early numbering // mention whether early or late numbering
{
  field ( readonly ) TravelId; // mention which field should be read only
  action acceptTravel result [1] $self;  //result[1] measn giving only one output and $self means
  action rejectTravel result [1] $self;

  factory action copyTravel [1]; //cardinality is mandatory for action and factory action not for internal action

  internal action recalcTotalPrice;
  create ( authorization : global ); // implementation for early numbering
  update;
  delete;
  // field ( readonly ) TravelId;
  association _Booking { create; }
  mapping for ztravel_tech_m // this is also new line for mapping // once after this mapping only we can create the new entries
    {
      TravelId      = travel_id;
      AgencyId      = agency_id;
      CustomerId    = customer_id;
      BeginDate     = begin_date;
      EndDate       = end_date;
      BookingFee    = booking_fee;
      TotalPrice    = total_price;
      CurrencyCode  = currency_code;
      Description   = description;
      OverallStatus = overall_status;
      CreatedBy     = created_by;
      CreatedAt     = created_at;
      LastChangedBy = last_changed_by;
      LastChangedAt = last_changed_at;
    }
}

define behavior for ZI_BOOKING_TECH_M_AUG //alias <alias_name>
implementation in class zbp_i_booking_tech_m_aug unique  // newly added line, press crtl + 1 to create implementation of the class
// created different behaviour pool for each entity for modularization purpose and neat code and smooth handling and to handle future changes
persistent table zbooking_tech_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt  // if we are using etag dependent by then lastchangedat field need to be commented then this etag
// dependent can be used.
early numbering
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId;
  association _Travel;
  association _BookingSupp { create; }
  mapping for zbooking_tech_m
    {
      TravelId      = travel_id;
      BookingId     = booking_id;
      BookingDate   = booking_date;
      CustomerId    = customer_id;
      CarrierId     = carrier_id;
      ConnectionId  = connection_id;
      FlightDate    = flight_date;
      FlightPrice   = flight_price;
      CurrencyCode  = currency_code;
      BookingStatus = booking_status;
      LastChangedAt = last_changed_at;
    }
}

define behavior for ZI_BOOKSUPPL_TECH_M_AUG //alias <alias_name>
implementation in class zbp_i_booksuppl_tech_m_aug unique
persistent table zbooksupp_tech_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt  // same for this as well
early numbering
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId, BookingSupplementId;
  association _Travel;
  association _Booking;
  mapping for zbooksupp_tech_m
    {
      TravelId            = travel_id;
      BookingId           = booking_id;
      BookingSupplementId = booking_supplement_id;
      SupplementId        = supplement_id;
      Price               = price;
      CurrencyCode        = currency_code;
      LastChangedAt       = last_changed_at;
    }
}